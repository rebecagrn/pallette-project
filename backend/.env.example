# OpenAI API key for AI-powered palette generation (optional)
# Without it, the backend uses rule-based color theory fallback
OPENAI_API_KEY=

# Optional shared secret required on POST /api/v1/palettes/generate
# Must match PALETTE_API_SECRET in the Next.js .env.local
API_SECRET=

# Server configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
